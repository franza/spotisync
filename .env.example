# Copy to .env and fill in. Real environment variables take precedence.
# No client secrets are needed: both services use OAuth PKCE.

# https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=

# https://developer.tidal.com/dashboard → your app
TIDAL_CLIENT_ID=

# Optional. These must exactly match the redirect URIs registered in each dashboard.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# TIDAL_REDIRECT_URI=http://localhost:8889/callback

# Optional. Defaults to the country of your TIDAL account.
# TIDAL_COUNTRY_CODE=US

# Optional. Space-separated TIDAL scopes (default shown).
# TIDAL_SCOPES=user.read playlists.read playlists.write search.read
